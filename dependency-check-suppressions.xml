<!--
    OWASP Dependency-Check Suppression File
    ========================================
    Use this file to suppress known false positives identified during scans.

    How to suppress:
      1. Run: ./gradlew :app:dependencyCheckAnalyze
      2. Open: app/build/reports/dependency-check/dependency-check-report.html
      3. For each false positive, add a <suppress> block below using the
         packageUrl (from the report) and the CVE ID.

    Documentation: https://jeremylong.github.io/DependencyCheck/general/suppression.html
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
        TEMPLATE:
        <suppress>
            <notes><![CDATA[Reason: ... Reviewed: DD-Mon-YYYY]]></notes>
            <packageUrl regex="true">^pkg:maven/group\.id\/artifact\-id@.*$</packageUrl>
            <cve>CVE-XXXX-XXXXX</cve>
        </suppress>
    -->

    <!-- ==========================================================================
         SECTION 1 — CONFIRMED FALSE POSITIVES
         Wrong CPE matched / misidentified library
         ========================================================================== -->

    <!--
        FALSE POSITIVE: androidx.sqlite artifacts (Room 2.6.2) misidentified as
        SQLite engine version 2.6.2. CVEs target the SQLite C binary engine.
        Android OS controls the actual on-device SQLite engine version.
    -->
    <suppress>
        <notes><![CDATA[
            False positive: AndroidX Room SQLite wrapper version 2.6.2 misidentified as
            SQLite engine version 2.6.2. CVEs target the SQLite C binary, not the Room wrapper.
            Reviewed: 07-Jun-2026
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/androidx\.sqlite/sqlite.*@.*$</packageUrl>
        <cpe>cpe:/a:sqlite:sqlite</cpe>
    </suppress>

