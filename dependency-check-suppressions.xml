    <!-- ==========================================================================
         SECTION 2 — NOT APPLICABLE ON ANDROID PLATFORM
         CVEs that only affect JVM desktop / Windows environments
         ========================================================================== -->

    <!--
        NOT APPLICABLE (PLATFORM): CVE-2020-29582 affects Kotlin's use of
        java.io.File.createTempFile() which creates world-readable temp files
        on UNIX/Windows JVM. Android does not use this temp file path, uses
        app-private sandboxed storage, and the vulnerable code path is only
        reachable on desktop JVM environments.
        Applies to: kotlin-stdlib, kotlin-reflect, kotlin-stdlib-jdk7/jdk8/common
    -->
    <suppress>
        <notes><![CDATA[
            Not applicable on Android: CVE-2020-29582 concerns java.io.File.createTempFile()
            creating world-readable /tmp files on JVM/Windows. Android uses app-private
            sandboxed storage; this code path is not reachable on Android platform.
            Reviewed: 07-Jun-2026
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.jetbrains\.kotlin/kotlin.*@.*$</packageUrl>
        <cve>CVE-2020-29582</cve>
    </suppress>

